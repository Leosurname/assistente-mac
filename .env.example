# Modelo de configuracao do Assistente Mac.
# Copie para .env e ajuste. O .env nunca vai para o repositorio.
#
# Nenhuma variavel aqui carrega segredo: a Layla roda no localhost, servida
# pelo llama-server do llama.cpp, e nao pede chave de API.

# Endereco do llama-server. Aceita tambem a URL completa do endpoint.
LAYLA_URL=http://127.0.0.1:8080

# Nome do modelo a pedir ao servidor. Com um unico modelo carregado, o
# llama-server aceita o pedido sem este campo.
LAYLA_MODEL=mistral-7b-v0.1-layla-v4-chatml

# Ajustes finos da conversa com a Layla.
LAYLA_TIMEOUT=30
LAYLA_TENTATIVAS=3
LAYLA_LIMITE_CONTEXTO=4096
LAYLA_TEMPERATURA=0.2

# Backend.
ASSISTENTE_PORTA=8765
LOG_LEVEL=INFO
